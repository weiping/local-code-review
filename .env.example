# Copy to .env in the repository root; the pre-push hook loads it automatically.
# Keep comments on their own lines: inline "# ..." after a value may be read as part of the value by non-shell parsers.

# Magpie's local gateway; any OpenAI-compatible URL works.
# LLM_BASE_URL=http://127.0.0.1:3425/v1

# AI_REVIEW_MODEL=auto/glm-5.3

# Optional extra context files for the reviewer (review.py --context), space-separated, no spaces in paths. Leave unset unless needed.
# AI_REVIEW_CONTEXT=path/to/relevant_file.py

# warn lets an incomplete review through; block stops the push.
# AI_REVIEW_ON_INCOMPLETE=warn
